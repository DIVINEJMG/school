<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bots School</title>
<style>
  body { font-family: Arial, sans-serif; margin: 0; background: #f4f7fb; color: #223; }
